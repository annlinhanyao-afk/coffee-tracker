{
  "manifest_version": 3,
  "name": "生活碎片剪刀手",
  "short_name": "碎片剪刀手",
  "description": "在任意网页上点击剪下你喜欢的一角，自动裁出带白边的贴纸图片并下载。",
  "version": "1.0.0",
  "action": {
    "default_title": "剪下这个网页的一部分"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "background": {
    "service_worker": "background.js"
  }
}
